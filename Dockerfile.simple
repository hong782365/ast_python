FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 仅复制必要文件进行测试
COPY requirements-container.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 复制主要应用文件
COPY publisher.py .
COPY config.py .
COPY python_protogen/ ./python_protogen/

# 暴露端口
EXPOSE 9000

# 启动命令
CMD ["python", "publisher.py"]